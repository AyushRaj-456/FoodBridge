# FoodBridge Client Environment Configuration (Firebase Spark ₹0 Baseline)
# DO NOT place server private keys, service accounts, or paid API keys here.
# Copy this file to .env.local to configure your local environment.

# ==============================================================================
# MODE 1: LOCAL DEMO EMULATOR SANDBOX (Recommended for local dev & testing)
# ==============================================================================
# Set to 'true' to run entirely against local Firebase Emulators (zero network calls, zero quota usage)
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-foodbridge-local
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-foodbridge-local.firebaseapp.com
VITE_FIREBASE_APP_ID=1:1234567890:web:demoapp

# Optional emulator host overrides (defaults to 127.0.0.1:9099 and 127.0.0.1:8080)
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ==============================================================================
# MODE 2: PRODUCTION / STAGING (Firebase Spark Plan ₹0)
# ==============================================================================
# VITE_USE_FIREBASE_EMULATOR=false
# VITE_FIREBASE_API_KEY=AIzaSy...
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_APP_ID=1:...:web:...
# VITE_FIREBASE_MESSAGING_SENDER_ID=...
